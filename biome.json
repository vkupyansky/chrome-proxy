{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": ["src/**", "tests/**", "scripts/**", "*.json", "styles.css", "!package-lock.json"]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "error" },
      "style": { "useImportType": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
