{
  "manifest_version": 3,
  "name": "Chrome Proxy",
  "version": "2.1.1",
  "description": "Прокси для профиля Chrome и исключения для сайтов",
  "permissions": [
    "activeTab",
    "proxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Chrome Proxy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
